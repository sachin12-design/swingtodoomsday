# Get a free key at https://www.themoviedb.org/settings/api
# Copy this file to .env.local and fill it in. Never commit .env.local
VITE_TMDB_KEY=
# Your region code drives which OTT providers show up (IN, US, GB...)
VITE_WATCH_REGION=IN

# Accounts (optional) — free project at https://supabase.com
# With these set, Google + magic-link sign-in switch on; without them
# the site runs in guest mode (progress stays on the device).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
